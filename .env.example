# Copy this file to .env and fill in your values
# Get your API key from https://studio.nebius.com/

NEBIUS_API_KEY=your_nebius_api_key_here

# Model to use for the main agent
# Recommended: a strong instruction-following model from Nebius Token Factory
NEBIUS_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Base URL for Nebius Token Factory (OpenAI-compatible)
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
